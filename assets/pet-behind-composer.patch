+import { describe, expect, it } from 'vitest'
+import { buildComposerClip } from './composer-clip'
+
+describe('buildComposerClip', () => {
+ const pet = { left: 100, top: 100, right: 200, bottom: 200 }
+ it('returns none without overlap', () => expect(buildComposerClip(pet, {left:201,top:100,right:250,bottom:160})).toBe('none'))
+ it('uses the full unbounded composer outline for partial overlap', () => {
+  const clip = buildComposerClip(pet, {left:150,top:140,right:250,bottom:240})
+  expect(clip).toContain('M 50 40 H 150 V 140 H 50 Z')
+  expect(clip).not.toContain('V 100 H 50')
+ })
+ it('does not manufacture corners when pet is fully inside composer', () => {
+  const clip = buildComposerClip(pet, {left:50,top:50,right:250,bottom:250}, [18,18,18,18])
+  expect(clip).toContain('M -32 -50 H 132 A 18 18 0 0 1 150 -32')
+  expect(clip).not.toContain('M 0 0')
+ })
+ it('uses circular SVG arcs at actual composer corners', () => {
+  const clip = buildComposerClip(pet, {left:150,top:140,right:250,bottom:240}, [12,8,6,4])
+  expect(clip).toContain('M 62 40 H 142 A 8 8 0 0 1 150 48')
+  expect(clip).toContain('A 6 6 0 0 1 144 140')
+ })
+ it('keeps the outline consistent as pet moves', () => {
+  const composer = {left:150,top:140,right:250,bottom:240}
+  const first = buildComposerClip(pet, composer, [10,10,10,10])
+  const moved = buildComposerClip({left:120,top:90,right:220,bottom:190}, composer, [10,10,10,10])
+  expect(moved).toContain('M 40 50 H 120 A 10 10 0 0 1 130 60')
+  expect(first).not.toBe(moved)
+ })
+ it('supports radius zero', () => expect(buildComposerClip(pet, {left:150,top:140,right:250,bottom:240})).toContain('M 50 40 H 150 V 140 H 50 Z'))
+})
diff --git a/apps/desktop/src/components/pet/composer-clip.ts b/apps/desktop/src/components/pet/composer-clip.ts
new file mode 100644
index 0000000000..fed67ef28e
--- /dev/null
+++ b/apps/desktop/src/components/pet/composer-clip.ts
@@ -0,0 +1,17 @@
+export interface Rect { left: number; top: number; right: number; bottom: number }
+export type CornerRadii = readonly [number, number, number, number]
+
+export function buildComposerClip(pet: Rect, composer: Rect | null, radii: CornerRadii = [0, 0, 0, 0]): string {
+  if (!composer || composer.right <= pet.left || composer.left >= pet.right || composer.bottom <= pet.top || composer.top >= pet.bottom) return 'none'
+
+  // Keep the complete composer outline: clipping its bounds to the pet would
+  // manufacture corners wherever the pet rectangle cuts through an edge.
+  const x = composer.left - pet.left, y = composer.top - pet.top
+  const w = composer.right - composer.left, h = composer.bottom - composer.top
+  const scale = Math.min(1, w / Math.max(2 * radii[0], 2 * radii[1], 2 * radii[2], 2 * radii[3], 1), h / Math.max(2 * radii[0], 2 * radii[1], 2 * radii[2], 2 * radii[3], 1))
+  const [tl, tr, br, bl] = radii.map(radius => Math.max(0, radius * scale))
+  const hole = radii.every(radius => radius <= 0)
+    ? `M ${x} ${y} H ${x + w} V ${y + h} H ${x} Z`
+    : `M ${x + tl} ${y} H ${x + w - tr} A ${tr} ${tr} 0 0 1 ${x + w} ${y + tr} V ${y + h - br} A ${br} ${br} 0 0 1 ${x + w - br} ${y + h} H ${x + bl} A ${bl} ${bl} 0 0 1 ${x} ${y + h - bl} V ${y + tl} A ${tl} ${tl} 0 0 1 ${x + tl} ${y} Z`
+  return `path(evenodd, \"M -10000 -10000 H 10000 V 10000 H -10000 Z ${hole}\")`
+}
