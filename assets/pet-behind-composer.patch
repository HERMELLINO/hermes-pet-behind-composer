index 0000000000..27660a0213
--- /dev/null
+++ b/apps/desktop/src/components/pet/use-composer-clip.ts
@@ -0,0 +1,100 @@
+import { type RefObject, useEffect } from 'react'
+
+import { buildComposerClip } from './composer-clip'
+
+const COMPOSER_SELECTOR = '[data-slot="composer-surface"], .composer-fallback-surface'
+
+function visibleComposers(): HTMLElement[] {
+  return Array.from(document.querySelectorAll<HTMLElement>(COMPOSER_SELECTOR)).filter(el => {
+    const style = getComputedStyle(el)
+    const rects = el.getClientRects()
+    return style.display !== 'none' && style.visibility !== 'hidden' && style.visibility !== 'collapse'
+      && rects.length > 0 && Array.from(rects).some(rect => rect.width > 0 && rect.height > 0)
+  })
+}
+
+/** Occlude the interactive pet, and copy its pixels beneath the composer backing.
+ * The copy has no animation state or hit target; the original canvas owns both. */
+export function useComposerClip(petRef: RefObject<HTMLDivElement | null>, enabled: boolean): void {
+  useEffect(() => {
+    const pet = petRef.current
+    if (!enabled || !pet) return
+    let raf = 0
+    let last = ''
+    const ghosts = new Map<HTMLElement, HTMLCanvasElement>()
+    const removeGhosts = (keep: Set<HTMLElement> = new Set()) => {
+      for (const [composer, ghost] of ghosts) if (!keep.has(composer) || !composer.isConnected) {
+        ghost.remove(); ghosts.delete(composer)
+      }
+    }
+
+    const update = () => {
+      const rect = pet.getBoundingClientRect()
+      const composers = visibleComposers()
+      // Multiple outlines share one even-odd path, retaining every full rounded outline.
+      const holes = composers.map(composer => {
+        const bounds = composer.getBoundingClientRect()
+        if (bounds.right <= rect.left || bounds.left >= rect.right || bounds.bottom <= rect.top || bounds.top >= rect.bottom) return null
+        const s = getComputedStyle(composer), r = (v: string) => Number.parseFloat(v) || 0
+        return { bounds, radii: [s.borderTopLeftRadius, s.borderTopRightRadius, s.borderBottomRightRadius, s.borderBottomLeftRadius].map(r) as [number, number, number, number] }
+      }).filter((x): x is NonNullable<typeof x> => x !== null)
+      const clipPath = holes.length ? `path(evenodd, "M -10000 -10000 H 10000 V 10000 H -10000 Z ${holes.map(({bounds, radii}) => {
+        const one = buildComposerClip(rect, bounds, radii)
+        return one.slice(one.indexOf(' Z ') + 3, -2)
+      }).join(' ')}")` : 'none'
+      if (clipPath !== last) {
+        last = clipPath
+        pet.style.clipPath = clipPath
+        pet.style.setProperty('-webkit-clip-path', clipPath)
+      }
+
+      const source = pet.querySelector('canvas')
+      const underlays = new Set(composers.filter(composer => {
+        const b = composer.getBoundingClientRect()
+        return b.right > rect.left && b.left < rect.right && b.bottom > rect.top && b.top < rect.bottom
+      }))
+      removeGhosts(underlays)
+      if (!source || !source.width || !source.height) { removeGhosts(); return }
+      for (const composer of underlays) {
+        const bounds = composer.getBoundingClientRect()
+        let ghost = ghosts.get(composer)
+        if (!ghost) {
+          ghost = document.createElement('canvas')
+          ghost.dataset.petComposerUnderlay = ''
+          ghost.setAttribute('aria-hidden', 'true')
+          Object.assign(ghost.style, { position: 'absolute', pointerEvents: 'none', zIndex: '-20' })
+          composer.append(ghost); ghosts.set(composer, ghost)
+        }
+        if (ghost.width !== source.width) ghost.width = source.width
+        if (ghost.height !== source.height) ghost.height = source.height
+        const sourceRect = source.getBoundingClientRect()
+        Object.assign(ghost.style, { left: `${sourceRect.left - bounds.left - composer.clientLeft}px`, top: `${sourceRect.top - bounds.top - composer.clientTop}px`, width: `${sourceRect.width}px`, height: `${sourceRect.height}px`, transform: source.parentElement ? getComputedStyle(source.parentElement).transform : 'none' })
+        const ctx = ghost.getContext('2d')
+        if (ctx) { ctx.clearRect(0, 0, ghost.width, ghost.height); ctx.drawImage(source, 0, 0) }
+      }
+    }
+    const schedule = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update() }) }
+    const mutation = new MutationObserver(schedule)
+    mutation.observe(pet, { attributes: true, attributeFilter: ['style'], subtree: true, childList: true })
+    const resize = new ResizeObserver(schedule)
+    const watchComposer = () => {
+      resize.disconnect(); resize.observe(pet)
+      visibleComposers().forEach(el => resize.observe(el))
+      schedule()
+    }
+    const tree = new MutationObserver(watchComposer)
+    tree.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['style', 'class'] })
+    pet.addEventListener('hermes-pet-frame', update)
+    window.addEventListener('resize', schedule)
+    window.addEventListener('scroll', schedule, true)
+    watchComposer(); update()
+    return () => {
+      mutation.disconnect(); tree.disconnect(); resize.disconnect()
+      pet.removeEventListener('hermes-pet-frame', update)
+      window.removeEventListener('resize', schedule); window.removeEventListener('scroll', schedule, true)
+      if (raf) cancelAnimationFrame(raf)
+      removeGhosts()
+      pet.style.clipPath = ''; pet.style.setProperty('-webkit-clip-path', '')
+    }
+  }, [enabled, petRef])
+}
